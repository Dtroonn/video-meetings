# Matches the defaults of the root `compose.yaml` Postgres service (`pnpm db:up`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings

# JWT signing secrets — use long random strings (e.g. `openssl rand -base64 48`), different for each.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Token lifetimes in seconds (defaults: 15 minutes / 7 days).
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
